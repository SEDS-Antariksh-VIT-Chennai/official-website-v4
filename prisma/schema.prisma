// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// NextAuth Tables
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(USER)
  accounts      Account[]
  sessions      Session[]
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum Role {
  USER
  ADMIN
}

// App Models
model Event {
  id          String   @id @default(cuid())
  title       String
  date        DateTime
  location    String
  description String   @db.Text
  coverImage  String
  images      String[]
  gallery     String[]
  schedule    Json?
  registrationLink String?
  fee         String?
  buttons     Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model TeamMember {
  id          String   @id @default(cuid())
  name        String
  role        String
  department  String
  image       String
  github      String?
  linkedin    String?
  portfolio   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Application {
  id          String   @id @default(cuid())
  name        String
  email       String
  phone       String
  university  String
  department  String
  year        String
  portfolio   String?
  resumeUrl   String?
  reason      String?  @db.Text
  linkedin    String?
  github      String?
  customAnswers Json?  // Stores answers to custom fields defined in FormConfig
  status      AppStatus @default(PENDING)
  createdAt   DateTime @default(now())
}

enum AppStatus {
  PENDING
  REVIEWED
  ACCEPTED
  REJECTED
}

model FormConfig {
  id               String   @id @default("default")
  isOpen           Boolean  @default(true)
  requireResume    Boolean  @default(true)
  requirePortfolio Boolean  @default(false)
  customFields     Json?    // Stores an array of { id, type, label, required } for dynamic fields
  updatedAt        DateTime @updatedAt
}
